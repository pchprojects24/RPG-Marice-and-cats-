      "name": "Open-Meteo",
      "category": "Weather & Environment",
      "description": "Free weather forecast API for non-commercial use. Provides hourly and daily forecasts for any latitude/longitude worldwide using data from multiple meteorological services.",
      "auth_type": "none",
      "cors": true,
      "free_tier_limits": "Unlimited for non-commercial use",
      "rate_limits": "10,000 requests/day (soft limit)",
      "base_url": "https://api.open-meteo.com/v1",
      "example_endpoint": "https://api.open-meteo.com/v1/forecast?latitude=45.42&longitude=-75.69&current_weather=true",
      "example_params": {
        "latitude": "45.42",
        "longitude": "-75.69",
        "current_weather": "true",
        "hourly": "temperature_2m,precipitation"
      },
      "response_format": "JSON",
      "docs_url": "https://open-meteo.com/en/docs",
      "use_cases": ["Weather widgets", "Travel apps", "Outdoor activity planners", "Agriculture dashboards"],
      "notes": "No API key required. Excellent CORS support. Works directly from browser. One of the best free weather APIs available.",
      "cors_testable": true
